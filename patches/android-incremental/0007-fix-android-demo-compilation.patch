From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ghajarvpn Build <build@ghajarvpn.local>
Date: Thu, 27 Aug 2026 10:00:00 +0000
Subject: [PATCH] fix(android): restore demo compilation and declare its core API floor

Restore the small compile fixes present in the downloaded local demo:
JobScheduler imports, Compose scope import, store URL, Set conversion,
the VPN permission callback type and the OpenVPN BuildConfig flavor.

Use -Pghajar.demo=true for API 26+ demo builds, matching the bundled core
AAR. Keep the API 24 production target and manifest merger checks intact;
Android 7 support still requires rebuilding or replacing the core.

---
diff --git a/app/build.gradle.kts b/app/build.gradle.kts
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -5,20 +5,24 @@
     alias(libs.plugins.kotlin.compose)
 }
 
-android {
-    namespace = "net.gozar.app"
-    compileSdk {
-        version = release(36) {
-            minorApiLevel = 1
-        }
-    }
-
-    defaultConfig {
-        applicationId = "com.ghajarvpn.app"
-        minSdk = 24
-        targetSdk = 36
-        versionCode = 30000
-        versionName = "3.0.0"
+val ghajarDemoBuild = providers.gradleProperty("ghajar.demo").orNull == "true"
+
+android {
+    namespace = "net.gozar.app"
+    compileSdk {
+        version = release(36) {
+            minorApiLevel = 1
+        }
+    }
+
+    defaultConfig {
+        applicationId = "com.ghajarvpn.app"
+        // The bundled core AAR requires API 26. Keep the API 24 release target
+        // explicit while building an honestly labelled Android 8+ demo.
+        minSdk = if (ghajarDemoBuild) 26 else 24
+        targetSdk = 36
+        versionCode = 30000
+        versionName = if (ghajarDemoBuild) "3.0.0-demo" else "3.0.0"
         testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
     }
 
