From: Ghajarvpn Build <build@ghajarvpn.local>
Date: Tue, 1 Sep 2026 17:32:47 +0000
Subject: [PATCH] fix(openvpn): run embedded engine in Ghajar and own global
 tunnel state

---
 .../java/net/gozar/app/GhajarOpenVpnBridge.kt | 101 +++++++++++++++---
 .../main/java/net/gozar/app/MainActivity.kt   |  31 +++++-
 openvpn/src/main/AndroidManifest.xml          |   8 +-
 3 files changed, 115 insertions(+), 25 deletions(-)

diff --git a/app/src/main/java/net/gozar/app/GhajarOpenVpnBridge.kt b/app/src/main/java/net/gozar/app/GhajarOpenVpnBridge.kt
index b67a523..99495eb 100644
--- a/app/src/main/java/net/gozar/app/GhajarOpenVpnBridge.kt
+++ b/app/src/main/java/net/gozar/app/GhajarOpenVpnBridge.kt
@@ -75,6 +75,9 @@ object GhajarOpenVpnBridge {
     private var statusListener: StatusListener? = null
     private var stateListener: VpnStatus.StateListener? = null
     private var requestedUuid: String? = null
+    private var connectedConfirmed = false
+    private var connectedAtElapsed = 0L
+    private var explicitDisconnect = false
     private var requestStartedAt = 0L
 
     fun initialize(context: Context) {
@@ -105,31 +108,75 @@ object GhajarOpenVpnBridge {
                 Intent: android.content.Intent?
             ) {
                 val text = logmessage.trim().ifBlank { state.trim() }
-                if (text.isNotBlank()) _lastMessage.value = text
-                val elapsed = SystemClock.elapsedRealtime() - requestStartedAt
-                _status.value = when (level) {
-                    ConnectionStatus.LEVEL_CONNECTED -> GhajarOvpnState.CONNECTED
+                if (text.isNotBlank()) _lastMessage.value = publicEngineMessage(text)
+                val now = SystemClock.elapsedRealtime()
+                val elapsed = now - requestStartedAt
+                when (level) {
+                    ConnectionStatus.LEVEL_CONNECTED -> {
+                        val uuid = _activeUuid.value ?: requestedUuid
+                        connectedConfirmed = true
+                        connectedAtElapsed = now
+                        requestedUuid = null
+                        explicitDisconnect = false
+                        _status.value = GhajarOvpnState.CONNECTED
+                        if (uuid != null) {
+                            if (VpnState.activeId.value != "ovpn:$uuid") VpnState.setConnecting("ovpn:$uuid")
+                            VpnState.setConnected()
+                        }
+                    }
                     ConnectionStatus.LEVEL_AUTH_FAILED,
                     ConnectionStatus.LEVEL_NONETWORK,
-                    ConnectionStatus.LEVEL_WAITING_FOR_USER_INPUT -> GhajarOvpnState.ERROR
+                    ConnectionStatus.LEVEL_WAITING_FOR_USER_INPUT -> {
+                        _status.value = GhajarOvpnState.ERROR
+                        requestedUuid = null
+                        connectedConfirmed = false
+                        _activeUuid.value = null
+                        if (ownsGlobalTunnel()) VpnState.setError(_lastMessage.value.ifBlank { "OpenVPN متصل نشد" })
+                    }
                     ConnectionStatus.LEVEL_NOTCONNECTED -> {
-                        if (requestedUuid != null && elapsed in 0..1499) GhajarOvpnState.CONNECTING
-                        else GhajarOvpnState.DISCONNECTED
+                        val keepConnectedGrace = connectedConfirmed && now - connectedAtElapsed < 1_200L && !explicitDisconnect
+                        _status.value = when {
+                            explicitDisconnect -> GhajarOvpnState.DISCONNECTED
+                            keepConnectedGrace -> GhajarOvpnState.CONNECTED
+                            requestedUuid != null && elapsed in 0..7_999 -> GhajarOvpnState.CONNECTING
+                            else -> GhajarOvpnState.DISCONNECTED
+                        }
+                        if (_status.value == GhajarOvpnState.DISCONNECTED) {
+                            connectedConfirmed = false
+                            requestedUuid = null
+                            if (ownsGlobalTunnel()) VpnState.setDisconnected()
+                        }
                     }
                     ConnectionStatus.LEVEL_START,
                     ConnectionStatus.LEVEL_CONNECTING_SERVER_REPLIED,
-                    ConnectionStatus.LEVEL_CONNECTING_NO_SERVER_REPLY_YET -> GhajarOvpnState.CONNECTING
-                    ConnectionStatus.LEVEL_VPNPAUSED -> GhajarOvpnState.DISCONNECTED
-                    ConnectionStatus.UNKNOWN_LEVEL -> if (requestedUuid != null) GhajarOvpnState.CONNECTING else GhajarOvpnState.DISCONNECTED
-                }
-                if (_status.value == GhajarOvpnState.DISCONNECTED || _status.value == GhajarOvpnState.ERROR) {
-                    if (elapsed > 1500) requestedUuid = null
+                    ConnectionStatus.LEVEL_CONNECTING_NO_SERVER_REPLY_YET -> {
+                        if (!connectedConfirmed && (requestedUuid != null || _activeUuid.value != null)) {
+                            _status.value = GhajarOvpnState.CONNECTING
+                        }
+                    }
+                    ConnectionStatus.LEVEL_VPNPAUSED -> {
+                        connectedConfirmed = false
+                        _status.value = GhajarOvpnState.DISCONNECTED
+                        if (ownsGlobalTunnel()) VpnState.setDisconnected()
+                    }
+                    ConnectionStatus.UNKNOWN_LEVEL -> {
+                        if (!connectedConfirmed && requestedUuid != null) _status.value = GhajarOvpnState.CONNECTING
+                    }
                 }
             }
 
             override fun setConnectedVPN(uuid: String?) {
                 val clean = uuid?.takeIf { it.isNotBlank() }
-                _activeUuid.value = clean ?: requestedUuid
+                if (clean != null) {
+                    _activeUuid.value = clean
+                } else {
+                    _activeUuid.value = null
+                    if (connectedConfirmed) {
+                        connectedConfirmed = false
+                        _status.value = GhajarOvpnState.DISCONNECTED
+                        if (ownsGlobalTunnel()) VpnState.setDisconnected()
+                    }
+                }
             }
         }
         VpnStatus.addStateListener(stateListener)
@@ -223,10 +270,14 @@ object GhajarOpenVpnBridge {
         require(profile.needUserPWInput(null, null) == 0) { "نام کاربری یا رمز عبور این پروفایل لازم است" }
 
         requestedUuid = uuid
+        connectedConfirmed = false
+        connectedAtElapsed = 0L
+        explicitDisconnect = false
         requestStartedAt = SystemClock.elapsedRealtime()
         _activeUuid.value = uuid
         _status.value = GhajarOvpnState.CONNECTING
         _lastMessage.value = "در حال راه‌اندازی موتور OpenVPN…"
+        VpnState.setConnecting("ovpn:$uuid")
 
         val intent = profile.getStartServiceIntent(app, "Ghajarvpn user request", true)
             ?: throw IllegalStateException("OpenVPN نتوانست Intent اتصال را بسازد")
@@ -235,8 +286,11 @@ object GhajarOpenVpnBridge {
             else app.startService(intent)
         } catch (t: Throwable) {
             requestedUuid = null
+            connectedConfirmed = false
+            _activeUuid.value = null
             _status.value = GhajarOvpnState.ERROR
-            _lastMessage.value = "اجرای سرویس OpenVPN ناموفق بود: ${t.message ?: t.javaClass.simpleName}"
+            _lastMessage.value = publicEngineMessage(t.message ?: t.javaClass.simpleName)
+            VpnState.setError(_lastMessage.value)
             throw IllegalStateException(_lastMessage.value, t)
         }
     }
@@ -301,6 +355,7 @@ object GhajarOpenVpnBridge {
         runCatching {
             val app = context.applicationContext
             ensureOpenVpnServiceInstalled(app)
+            explicitDisconnect = true
             val latch = CountDownLatch(1)
             var service: IOpenVPNServiceInternal? = null
             val connection = object : ServiceConnection {
@@ -320,8 +375,11 @@ object GhajarOpenVpnBridge {
                 VpnStatus.updateStateString("DISCONNECTED", "", 0, ConnectionStatus.LEVEL_NOTCONNECTED)
             }
             requestedUuid = null
+            connectedConfirmed = false
             _activeUuid.value = null
             _status.value = GhajarOvpnState.DISCONNECTED
+            if (VpnState.activeId.value.orEmpty().startsWith("ovpn:")) VpnState.setDisconnected()
+            explicitDisconnect = false
         }
     }
 
@@ -336,6 +394,19 @@ object GhajarOpenVpnBridge {
         }
     }
 
+    private fun ownsGlobalTunnel(): Boolean = VpnState.activeId.value.orEmpty().startsWith("ovpn:")
+
+    private fun publicEngineMessage(raw: String): String {
+        val clean = BrandConfig.sanitizePublicText(raw).replace(Regex("\\s+"), " ").trim()
+        return when {
+            clean.contains("Unable to start service Intent", ignoreCase = true) ->
+                "موتور OpenVPN اندروید اجرا نشد؛ سرویس داخلی قاجار در دسترس نیست"
+            clean.contains("AUTH_FAILED", ignoreCase = true) -> "نام کاربری یا رمز OpenVPN رد شد"
+            clean.length > 180 -> clean.take(177) + "…"
+            else -> clean.ifBlank { "OpenVPN متصل نشد" }
+        }
+    }
+
     private fun toUi(profile: VpnProfile): GhajarOvpnProfile = GhajarOvpnProfile(
         uuid = profile.getUUIDString(),
         name = BrandConfig.sanitizePublicText(profile.mName.ifBlank { "سرویس OVPN قاجار" }),
diff --git a/app/src/main/java/net/gozar/app/MainActivity.kt b/app/src/main/java/net/gozar/app/MainActivity.kt
index 680e566..0008659 100644
--- a/app/src/main/java/net/gozar/app/MainActivity.kt
+++ b/app/src/main/java/net/gozar/app/MainActivity.kt
@@ -815,12 +815,27 @@ class MainActivity : ComponentActivity() {
         }
     }
 
+    private suspend fun stopOtherTunnelBeforeOpenVpn() {
+        val activeId = VpnState.activeId.value.orEmpty()
+        if (activeId.startsWith("ovpn:")) return
+        if (VpnState.state.value != Connection.CONNECTED && VpnState.state.value != Connection.CONNECTING) return
+        disconnect()
+        withTimeoutOrNull(6_000L) {
+            VpnState.state.first { it == Connection.DISCONNECTED || it == Connection.ERROR }
+        }
+        if (VpnState.state.value != Connection.DISCONNECTED) VpnState.setDisconnected()
+        delay(250)
+    }
+
     private fun connectSavedOpenVpn(uuid: String) {
         val start: () -> Unit = {
-            val launched = GhajarOpenVpnBridge.connectSaved(this, uuid)
-                .onFailure { Toast.makeText(this, it.message ?: "اتصال OVPN ناموفق بود", Toast.LENGTH_LONG).show() }
-            if (launched.isFailure) Toast.makeText(this, "اتصال OVPN آغاز نشد", Toast.LENGTH_LONG).show()
-            else Toast.makeText(this, "اتصال OVPN آغاز شد", Toast.LENGTH_SHORT).show()
+            lifecycleScope.launch {
+                stopOtherTunnelBeforeOpenVpn()
+                val launched = GhajarOpenVpnBridge.connectSaved(this@MainActivity, uuid)
+                    .onFailure { Toast.makeText(this@MainActivity, it.message ?: "اتصال OVPN ناموفق بود", Toast.LENGTH_LONG).show() }
+                if (launched.isFailure) Toast.makeText(this@MainActivity, "اتصال OVPN آغاز نشد", Toast.LENGTH_LONG).show()
+                else Toast.makeText(this@MainActivity, "اتصال OVPN آغاز شد", Toast.LENGTH_SHORT).show()
+            }
             Unit
         }
         val permission = VpnService.prepare(this)
@@ -840,6 +855,7 @@ class MainActivity : ComponentActivity() {
     private fun testSavedOpenVpn(uuid: String) {
         val start: () -> Unit = {
             lifecycleScope.launch {
+                stopOtherTunnelBeforeOpenVpn()
                 val result = GhajarOpenVpnBridge.testSaved(this@MainActivity, uuid)
                 Toast.makeText(
                     this@MainActivity,
@@ -969,6 +985,9 @@ class MainActivity : ComponentActivity() {
                 if (activeId == null) {
                     android.util.Log.d(tag, "skip: no active config id"); continue
                 }
+                if (activeId.startsWith("ovpn:")) {
+                    android.util.Log.d(tag, "skip: OpenVPN owns the active tunnel"); continue
+                }
                 val activeCfg = store.configs.value.find { it.id == activeId }
                 if (activeCfg?.protocol?.trim()?.lowercase() in setOf("tor", "aether")) {
                     android.util.Log.d(tag, "skip: active is ${activeCfg?.protocol}"); continue
@@ -1095,6 +1114,10 @@ class MainActivity : ComponentActivity() {
     }
 
     private fun disconnect() {
+        if (VpnState.activeId.value.orEmpty().startsWith("ovpn:")) {
+            lifecycleScope.launch { GhajarOpenVpnBridge.disconnect(this@MainActivity) }
+            return
+        }
         if (IkeController.active) {
             IkeController.disconnect(this)
             VpnState.setDisconnected()
