+    /**
+     * Start the exact service component shipped by ics-openvpn.  Some Android
+     * builds incorrectly reject startForegroundService() even while Ghajar is
+     * foreground; in that narrow case startService() is a valid fallback because
+     * OpenVPNService promotes itself to foreground immediately.
+     */
+    private fun startOpenVpnService(app: Context, intent: Intent) {
+        val component = intent.component ?: ComponentName(app, OpenVPNService::class.java)
+        val explicit = Intent(intent).setComponent(component).setPackage(app.packageName)
+        val resolved = runCatching {
+            @Suppress("DEPRECATION")
+            app.packageManager.getServiceInfo(component, PackageManager.GET_META_DATA)
+        }.getOrElse { throw IllegalStateException("OpenVPN service component is missing: ${component.className}", it) }
+        check(resolved.enabled) { "OpenVPN service component is disabled: ${component.className}" }
+
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) app.startForegroundService(explicit)
+            else app.startService(explicit)
+        } catch (first: IllegalStateException) {
+            val unableToStart = first.message?.contains("Unable to start service Intent", ignoreCase = true) == true
+            if (!unableToStart || Build.VERSION.SDK_INT < Build.VERSION_CODES.O) throw first
+            android.util.Log.w("GhajarOpenVPN", "Foreground start rejected; retrying explicit service start", first)
+            val started = app.startService(explicit)
+            if (started == null) throw first
+        }
+    }
