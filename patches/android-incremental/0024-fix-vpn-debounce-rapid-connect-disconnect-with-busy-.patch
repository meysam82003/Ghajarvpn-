From 74e28216adbbca361a6e37370b002e6d288c8ce6 Mon Sep 17 00:00:00 2001
From: meysam82003 <meysamsalamatnasab@gmail.com>
Date: Sun, 30 Aug 2026 13:24:58 +0330
Subject: [PATCH] fix(vpn): debounce rapid connect/disconnect with busy lock

---
 app/src/main/java/net/gozar/app/MainActivity.kt | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/app/src/main/java/net/gozar/app/MainActivity.kt b/app/src/main/java/net/gozar/app/MainActivity.kt
index 896c57c7..6f188ca3 100644
--- a/app/src/main/java/net/gozar/app/MainActivity.kt
+++ b/app/src/main/java/net/gozar/app/MainActivity.kt
@@ -964,9 +964,11 @@ class MainActivity : ComponentActivity() {
         }
     }
 
+    @Volatile private var vpnBusy = false
     private fun connectTo(config: ProxyConfig) {
         val s = VpnState.state.value
         if (s == Connection.CONNECTING || s == Connection.CONNECTED) return
+        if (vpnBusy) return
 
         if (!store.autoSelect.value) {
             launchConnect(config)
@@ -1160,12 +1162,18 @@ class MainActivity : ComponentActivity() {
     }
 
     private fun disconnect() {
+        if (vpnBusy) return
+        vpnBusy = true
         if (IkeController.active) {
             IkeController.disconnect(this)
             VpnState.setDisconnected()
             return
         }
         startService(Intent(this, GozarVpnService::class.java).setAction(GozarVpnService.ACTION_STOP))
+        lifecycleScope.launch {
+                withTimeoutOrNull(8000) { VpnState.state.first { it == Connection.DISCONNECTED || it == Connection.ERROR } }
+                vpnBusy = false
+        }
     }
 
     private fun switchTo(config: ProxyConfig) {
-- 
