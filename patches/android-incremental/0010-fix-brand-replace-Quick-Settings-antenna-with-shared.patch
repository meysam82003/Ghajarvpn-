From c449f2a4b46c69b399128b7fdbd3e1c75686b5f6 Mon Sep 17 00:00:00 2001
From: Ghajarvpn Build <build@ghajarvpn.local>
Date: Thu, 27 Aug 2026 15:51:09 +0400
Subject: [PATCH] fix(brand): replace Quick Settings antenna with shared Ghajar
 crown shield

---
 app/src/main/AndroidManifest.xml                |  2 +-
 .../main/java/net/gozar/app/Qstileservice.kt    | 17 +++++++++++++----
 app/src/main/res/drawable/ic_stat_ghajar.xml    | 10 +++++++---
 3 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index 31b2386..c2a96db 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -108,7 +108,7 @@
         <service
             android:name=".QsTileService"
             android:exported="true"
-            android:icon="@drawable/ic_qs_tile"
+            android:icon="@drawable/ic_stat_ghajar"
             android:label="@string/app_name"
             android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
             <intent-filter>
diff --git a/app/src/main/java/net/gozar/app/Qstileservice.kt b/app/src/main/java/net/gozar/app/Qstileservice.kt
index b7046df..6436627 100644
--- a/app/src/main/java/net/gozar/app/Qstileservice.kt
+++ b/app/src/main/java/net/gozar/app/Qstileservice.kt
@@ -147,14 +147,23 @@ class QsTileService : TileService() {
         }
         tile.state = if (active) Tile.STATE_ACTIVE else Tile.STATE_INACTIVE
         tile.label = Strings.get(lang, "app_title")
+        val status = when (VpnState.state.value) {
+            Connection.CONNECTING -> Strings.get(lang, "status_connecting")
+            Connection.ERROR -> Strings.get(lang, "status_error")
+            Connection.CONNECTED -> Strings.get(lang, "status_connected")
+            else -> if (active) Strings.get(lang, "status_connecting") else Strings.get(lang, "status_disconnected")
+        }
+        tile.contentDescription = "${tile.label}، $status"
         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
             tile.subtitle = when {
-                active -> Strings.get(lang, "status_connected")
-                selectedName != null -> selectedName
+                active -> status
+                selectedName != null -> BrandConfig.sanitizePublicText(selectedName)
                 else -> Strings.get(lang, "tap_choose")
             }
         }
-        runCatching { tile.icon = Icon.createWithResource(this, R.drawable.ic_qs_tile) }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) tile.stateDescription = status
+        // Update both the declared icon and runtime icon so cached tiles refresh.
+        runCatching { tile.icon = Icon.createWithResource(this, R.drawable.ic_stat_ghajar) }
         tile.updateTile()
     }
-}
\ No newline at end of file
+}
diff --git a/app/src/main/res/drawable/ic_stat_ghajar.xml b/app/src/main/res/drawable/ic_stat_ghajar.xml
index d43b94c..728e35e 100644
--- a/app/src/main/res/drawable/ic_stat_ghajar.xml
+++ b/app/src/main/res/drawable/ic_stat_ghajar.xml
@@ -3,7 +3,11 @@
     android:height="24dp"
     android:viewportWidth="24"
     android:viewportHeight="24">
-    <path
-        android:fillColor="#FFFFFFFF"
-        android:pathData="M4,7L6.5,3.5 9,7 12,2.5 15,7 17.5,3.5 20,7 18.8,10H5.2L4,7M6,11H18V13H17V19.2L12,22 7,19.2V13H6V11M9,14V18L12,19.7 15,18V14H9M10.5,16A1.5,1.5 0,1 0,13.5 16A1.5,1.5 0,1 0,10.5 16" />
+    <!-- Shared monochrome mark: transparent background, readable at 24dp. -->
+    <path android:fillColor="#FFFFFFFF"
+        android:pathData="M6,2L9,4L12,1L15,4L18,2L17,7H7Z" />
+    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
+        android:pathData="M4,8H20V13C20,18 16,21 12,23C8,21 4,18 4,13ZM6,10V13C6,17 9,19.5 12,20.8C15,19.5 18,17 18,13V10Z" />
+    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
+        android:pathData="M9,14V12.8C9,9.2 15,9.2 15,12.8V14H16V18H8V14ZM10.5,14H13.5V12.8C13.5,11 10.5,11 10.5,12.8Z" />
 </vector>
-- 
2.51.1

