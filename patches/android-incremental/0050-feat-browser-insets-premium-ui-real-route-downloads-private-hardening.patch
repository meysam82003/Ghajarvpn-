+    private fun switchRoute(mode: BrowserNetworkMode) {
+        dialog?.dismiss()
+        val engine = com.ghajarvpn.browser.network.BrowserRouteEngineHost.get()
+        val applied = routeManager.select(mode) { selected ->
+            when (selected) {
+                BrowserNetworkMode.DIRECT -> {
