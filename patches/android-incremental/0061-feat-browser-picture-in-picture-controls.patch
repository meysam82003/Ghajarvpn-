             buffering.visibility = if (state == Player.STATE_BUFFERING) View.VISIBLE else View.GONE
             if (state == Player.STATE_READY) {
diff --git a/browser/src/main/java/com/ghajarvpn/browser/media/MediaModels.kt b/browser/src/main/java/com/ghajarvpn/browser/media/MediaModels.kt
index 7117eac..9bc768e 100644
--- a/browser/src/main/java/com/ghajarvpn/browser/media/MediaModels.kt
+++ b/browser/src/main/java/com/ghajarvpn/browser/media/MediaModels.kt
@@ -34,6 +34,16 @@ data class VideoPlaybackState(
     val speed: Float = 1f
 )
 
+enum class PictureInPictureControl { SEEK_BACK, PLAY, PAUSE, SEEK_FORWARD }
+
+object PictureInPictureControlPolicy {
+    fun controls(isPlaying: Boolean): List<PictureInPictureControl> = listOf(
+        PictureInPictureControl.SEEK_BACK,
+        if (isPlaying) PictureInPictureControl.PAUSE else PictureInPictureControl.PLAY,
+        PictureInPictureControl.SEEK_FORWARD
+    )
+}
+
 object PlaybackLifecyclePolicy {
     fun shouldPause(
         backgroundAllowed: Boolean,
diff --git a/browser/src/main/java/com/ghajarvpn/browser/media/MediaPreferences.kt b/browser/src/main/java/com/ghajarvpn/browser/media/MediaPreferences.kt
index d66ed83..2b143c3 100644
