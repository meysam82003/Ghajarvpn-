From 4f77f5fc2bfec589c9aa8cf65e06413657e0d841 Mon Sep 17 00:00:00 2001
From: Ghajarvpn Build <build@ghajarvpn.local>
Date: Wed, 2 Sep 2026 18:22:00 +0330
Subject: [PATCH] fix(openvpn): restore upstream engine process isolation

Run the native OpenVPN engine and its status/API services in the dedicated
:openvpn process used by upstream ics-openvpn. Ghajar already initializes
StatusListener, whose AIDL bridge mirrors state from the remote process back
into the UI, so native failures cannot terminate the Ghajar UI process.
---
 openvpn/src/main/AndroidManifest.xml | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/openvpn/src/main/AndroidManifest.xml b/openvpn/src/main/AndroidManifest.xml
--- a/openvpn/src/main/AndroidManifest.xml
+++ b/openvpn/src/main/AndroidManifest.xml
@@ -30,11 +30,14 @@
             android:theme="@style/blinkt.dialog" />
 
 
+        <!-- Keep the native OpenVPN engine out of the Ghajar UI process. This mirrors
+             upstream ics-openvpn: a native engine failure must not terminate the app. -->
         <service
             android:name=".core.OpenVPNService"
             android:exported="true"
             android:permission="android.permission.BIND_VPN_SERVICE"
-            android:foregroundServiceType="specialUse">
+            android:foregroundServiceType="specialUse"
+            android:process=":openvpn">
             <intent-filter>
                 <action android:name="android.net.VpnService" />
             </intent-filter>
@@ -44,14 +47,18 @@
         <service
             android:name=".api.ExternalOpenVPNService"
             android:exported="false"
+            android:process=":openvpn"
                 tools:ignore="ExportedService">
             <intent-filter>
                 <action android:name="de.blinkt.openvpn.api.IOpenVPNAPIService" />
             </intent-filter>
         </service>
+        <!-- StatusListener is designed to bridge this remote process back to Ghajar
+             through IServiceStatus/IStatusCallbacks instead of static in-process state. -->
         <service
             android:name=".core.OpenVPNStatusService"
-            android:exported="false" />
+            android:exported="false"
+            android:process=":openvpn" />
 
         <activity android:name=".api.GrantPermissionsActivity"
                 android:exported="false">
-- 
