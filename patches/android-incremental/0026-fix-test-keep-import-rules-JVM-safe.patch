From 771493fbae496ada6496949df84f9e09d41c5a94 Mon Sep 17 00:00:00 2001
From: Ghajarvpn Build <build@ghajarvpn.local>
Date: Sat, 29 Aug 2026 18:38:15 -0400
Subject: [PATCH] fix(test): keep import rules JVM-safe

---
 .../java/net/gozar/app/GhajarAndroid14RegressionTest.kt       | 2 --
 app/src/main/java/net/gozar/app/GhajarImportRules.kt          | 4 ++--
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/app/src/androidTest/java/net/gozar/app/GhajarAndroid14RegressionTest.kt b/app/src/androidTest/java/net/gozar/app/GhajarAndroid14RegressionTest.kt
index d0ddc56..6266f10 100644
--- a/app/src/androidTest/java/net/gozar/app/GhajarAndroid14RegressionTest.kt
+++ b/app/src/androidTest/java/net/gozar/app/GhajarAndroid14RegressionTest.kt
@@ -7,7 +7,6 @@ import android.content.Intent
 import android.content.pm.PackageManager
 import android.graphics.Bitmap
 import android.os.Build
-import androidx.compose.ui.test.assertExists
 import androidx.compose.ui.test.junit4.createEmptyComposeRule
 import androidx.compose.ui.test.onNodeWithTag
 import androidx.compose.ui.test.performClick
@@ -45,7 +44,6 @@ class GhajarAndroid14RegressionTest {
                 compose.onAllNodes(androidx.compose.ui.test.hasTestTag("ghajar_welcome_poster"))
                     .fetchSemanticsNodes().isNotEmpty()
             }
-            compose.onNodeWithTag("ghajar_welcome_poster").assertExists()
             screenshot(context, "cold-welcome")
 
             val packageManager = context.packageManager
diff --git a/app/src/main/java/net/gozar/app/GhajarImportRules.kt b/app/src/main/java/net/gozar/app/GhajarImportRules.kt
index 43de9c3..cf7fc74 100644
--- a/app/src/main/java/net/gozar/app/GhajarImportRules.kt
+++ b/app/src/main/java/net/gozar/app/GhajarImportRules.kt
@@ -1,6 +1,6 @@
 package net.gozar.app
 
-import android.net.Uri
+import java.net.URI
 
 internal object GhajarImportRules {
     fun isNpvt(name: String?): Boolean = name?.trim()?.endsWith(".npvt", ignoreCase = true) == true
@@ -16,7 +16,7 @@ internal object GhajarImportRules {
     fun subscriptionUrl(text: String?): String? {
         val value = text?.trim()?.takeIf { it.isNotEmpty() && !it.contains('\n') && !it.contains('\r') }
             ?: return null
-        val uri = runCatching { Uri.parse(value) }.getOrNull() ?: return null
+        val uri = runCatching { URI(value) }.getOrNull() ?: return null
         if (uri.scheme?.lowercase() !in setOf("https", "http") || uri.host.isNullOrBlank() || uri.userInfo != null) return null
         return value
     }
-- 
2.51.1

