+                        else { pendingPermission = request; requestPermissions(arrayOf(Manifest.permission.CAMERA), CAMERA_REQUEST) }
+                    }.setNegativeButton("رد") { _, _ -> request.deny() }.setOnCancelListener { request.deny() }.show()
+            }
