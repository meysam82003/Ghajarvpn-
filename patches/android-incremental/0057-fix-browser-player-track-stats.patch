From d4cfe25a6e273bd74fbfe4eede12999a515993e6 Mon Sep 17 00:00:00 2001
From: Ghajarvpn Build <build@ghajarvpn.local>
Date: Thu, 3 Sep 2026 12:26:40 +0100
Subject: [PATCH] fix(browser): read video stats from player tracks

---
 .../com/ghajarvpn/browser/media/GhajarPlayerActivity.kt  | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/browser/src/main/java/com/ghajarvpn/browser/media/GhajarPlayerActivity.kt b/browser/src/main/java/com/ghajarvpn/browser/media/GhajarPlayerActivity.kt
index 860a095..399c1f5 100644
--- a/browser/src/main/java/com/ghajarvpn/browser/media/GhajarPlayerActivity.kt
+++ b/browser/src/main/java/com/ghajarvpn/browser/media/GhajarPlayerActivity.kt
@@ -376,7 +376,14 @@ class GhajarPlayerActivity : Activity() {
     private val statsUpdater = object : Runnable {
         override fun run() {
             if (::player.isInitialized && ::stats.isInitialized && stats.visibility == View.VISIBLE) {
-                val format = player.videoFormat
+                var format: androidx.media3.common.Format? = null
+                player.currentTracks.groups.forEach { group ->
+                    if (group.type == C.TRACK_TYPE_VIDEO) {
+                        for (index in 0 until group.length) {
+                            if (group.isTrackSelected(index)) format = group.getTrackFormat(index)
+                        }
+                    }
+                }
                 stats.text = "${format?.width ?: 0}×${format?.height ?: 0}  •  ${(format?.bitrate ?: 0) / 1000} kbps  •  buffer ${player.totalBufferedDuration / 1000}s"
             }
             handler.postDelayed(this, 1000)
