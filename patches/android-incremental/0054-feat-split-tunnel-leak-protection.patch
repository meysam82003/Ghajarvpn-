         put("onionRouting", _onionRouting.value)
         put("encryptedDns", _encryptedDns.value)
+        put("dnsLeakProtection", _dnsLeakProtection.value)
+        put("ipv6Mode", _ipv6Mode.value.name)
         put("fakeDns", _fakeDns.value)
