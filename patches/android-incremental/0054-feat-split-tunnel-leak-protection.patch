+        if (replacement == null) {
+            runCatching { Gozarcore.stop() }
+            runCatching { tunFd?.close() }; tunFd = null
+            VpnBridge.sendError(applicationContext, routingError ?: reason)
+            runCatching { stopForeground(STOP_FOREGROUND_REMOVE) }
+            stopSelf()
+            return
+        }
+        // Establishing the blocker replaces the old VPN atomically from Android's view.
+        runCatching { blockFd?.close() }
+        blockFd = replacement
+        runCatching { Gozarcore.stop() }
+        runCatching { tunFd?.close() }; tunFd = null
