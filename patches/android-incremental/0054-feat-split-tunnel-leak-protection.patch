diff --git a/app/src/main/java/net/gozar/app/ConfigStore.kt b/app/src/main/java/net/gozar/app/ConfigStore.kt
index 5b8846c..edcc9fc 100644
--- a/app/src/main/java/net/gozar/app/ConfigStore.kt
+++ b/app/src/main/java/net/gozar/app/ConfigStore.kt
@@ -154,6 +154,26 @@ class ConfigStore private constructor(context: Context) {
         prefs.edit().putBoolean(KEY_ENC_DNS, enabled).apply()
     }
 
+    private val _dnsLeakProtection = MutableStateFlow(prefs.getBoolean(KEY_DNS_LEAK_PROTECTION, true))
+    val dnsLeakProtection: StateFlow<Boolean> = _dnsLeakProtection.asStateFlow()
+
+    fun setDnsLeakProtection(enabled: Boolean) {
+        _dnsLeakProtection.value = enabled
+        prefs.edit().putBoolean(KEY_DNS_LEAK_PROTECTION, enabled).apply()
+    }
+
+    private val _ipv6Mode = MutableStateFlow(loadIpv6Mode())
+    val ipv6Mode: StateFlow<Ipv6Mode> = _ipv6Mode.asStateFlow()
+
+    private fun loadIpv6Mode(): Ipv6Mode = runCatching {
+        Ipv6Mode.valueOf(prefs.getString(KEY_IPV6_MODE, null) ?: Ipv6Mode.BLOCK.name)
+    }.getOrDefault(Ipv6Mode.BLOCK)
+
+    fun setIpv6Mode(mode: Ipv6Mode) {
+        _ipv6Mode.value = mode
+        prefs.edit().putString(KEY_IPV6_MODE, mode.name).apply()
+    }
+
     private val _fakeDns = MutableStateFlow(prefs.getBoolean(KEY_FAKE_DNS, false))
     val fakeDns: StateFlow<Boolean> = _fakeDns.asStateFlow()
 
@@ -387,6 +407,8 @@ class ConfigStore private constructor(context: Context) {
