+        if (o.has("dnsLeakProtection")) setDnsLeakProtection(o.getBoolean("dnsLeakProtection"))
+        o.optString("ipv6Mode").takeIf { it.isNotEmpty() }?.let { value ->
+            runCatching { setIpv6Mode(Ipv6Mode.valueOf(value)) }
+        }
         if (o.has("fakeDns")) setFakeDns(o.getBoolean("fakeDns"))
         if (o.has("adBlock")) setAdBlock(o.getBoolean("adBlock"))
         if (o.has("mixedPort")) setMixedPort(o.getInt("mixedPort"))
@@ -604,6 +630,8 @@ class ConfigStore private constructor(context: Context) {
