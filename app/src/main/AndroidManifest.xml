<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Connectivity callbacks: which physical network the device is on, for
         the per-network auto-connect rules and for keeping the tunnel's
         underlying network correct. A normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the in-app updater launch the system installer for a downloaded
         GitHub release APK; Android still requires the user's one-time
         "allow from this source" grant and the OS install confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Special-access permission for the per-app usage breakdown; there is no
         runtime prompt for this, only a per-app toggle under Settings > Usage
         access, which the app links to but cannot grant on the user's behalf. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".GozarApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ghajarvpn"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ghajarvpn"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-grt" />
                <data android:mimeType="application/x-openvpn-profile" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.grt" />
                <data android:pathPattern=".*\\..*\\.grt" />
                <data android:pathPattern=".*\\..*\\..*\\.grt" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.grt" />
                <data android:pathPattern=".*\\.ovpn" />
                <data android:pathPattern=".*\\..*\\.ovpn" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="happ" />
                <data android:scheme="happ-proxy" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SecurePaymentActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:label="پرداخت امن قاجار وی پی ان"
            android:theme="@style/Theme.Ghajarvpn" />
        <activity
            android:name=".GhajarStoreWebActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:label="قاجار وی پی ان"
            android:theme="@style/Theme.Ghajarvpn" />
        <activity
            android:name=".GhajarLogActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="لاگ و اشکال‌زدایی"
            android:theme="@style/Theme.Ghajarvpn" />
        <activity
            android:name=".ConfigCenterActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="مرکز کانفیگ قاجار"
            android:theme="@style/Theme.Ghajarvpn">
            <intent-filter android:label="مرکز کانفیگ قاجار">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="مرکز کانفیگ قاجار">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.npvt" />
                <data android:pathPattern=".*\\.npvs" />
                <data android:pathPattern=".*\\.npvtsub" />
                <data android:pathPattern=".*\\.happ" />
                <data android:pathPattern=".*\\.nm" />
                <data android:pathPattern=".*\\.ehi" />
                <data android:pathPattern=".*\\.slip" />
                <data android:pathPattern=".*\\.hat" />
                <data android:pathPattern=".*\\.dark" />
                <data android:pathPattern=".*\\.tnl" />
                <data android:pathPattern=".*\\.ovpn" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ConfigQuickConnectActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="اتصال به کانفیگ"
            android:theme="@style/Theme.Ghajarvpn" />
        <!--
            The home-screen widget. Its toggle is a broadcast to the provider;
            the connect itself is handed to the invisible activity below,
            because Android 12+ refuses a foreground-service start from a
            receiver and the tunnel would otherwise never start.
        -->
        <receiver
            android:name=".GhajarWidget"
            android:label="@string/widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="net.gozar.app.WIDGET_TOGGLE" />
                <!--
                    The three rail actions. Each one is declared so the
                    PendingIntent the widget builds is actually deliverable;
                    an undeclared action on an unexported receiver is dropped
                    silently, which reads as a button that does nothing.
                -->
                <action android:name="net.gozar.app.WIDGET_PING" />
                <action android:name="net.gozar.app.WIDGET_SUBS" />
                <action android:name="net.gozar.app.WIDGET_NEXT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ghajar_widget_info" />
        </receiver>

        <!--
            The one-cell widget: the logo, and the tunnel behind it. Its toggle
            goes through the same handler as the full widget's, so there is one
            implementation of turning the tunnel on and off, not two.
        -->
        <receiver
            android:name=".GhajarWidgetSmall"
            android:label="@string/widget_small_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="net.gozar.app.WIDGET_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ghajar_widget_small_info" />
        </receiver>
        <activity
            android:name=".GhajarWidgetConnectActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ghajarvpn.Invisible" />
        <service
            android:name=".GozarVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunneling client" />
        </service>
        <!--
            DNS-only mode's own VpnService.

            Deliberately WITHOUT the android.net.VpnService intent-filter. VPN
            consent is granted to the app by VpnService.prepare(), not to a
            particular service, and that filter is what nominates a service as
            the app's always-on VPN. Declaring it on two services leaves which
            one the system picks for always-on ambiguous, and the tunnel is the
            one that should win that.
        -->
        <service
            android:name=".GhajarDnsOnlyService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="DNS resolver selection" />
        </service>
        <service
            android:name=".GhajarNotificationJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <receiver android:name=".GhajarNotificationBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
            The "خوندم" button on a notice in the shade. Not exported: the only
            thing that ever sends this is the app's own PendingIntent, and an
            exported receiver would let any app on the device mark someone's
            warnings read.
        -->
        <receiver android:name=".GhajarNoticeAckReceiver" android:exported="false">
            <intent-filter>
                <action android:name="net.gozar.app.action.NOTICE_ACK" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".QsTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_ghajar"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>

</manifest>
