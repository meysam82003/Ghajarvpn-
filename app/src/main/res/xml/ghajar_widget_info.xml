<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis is 0 on purpose. The platform's own period cannot be
    shorter than 30 minutes, which is useless for a connection state - the
    widget is pushed instead, from GhajarWidget.refresh() on every state
    change, so it is never stale and never wakes the device on a timer.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="90dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_ghajar"
    android:previewLayout="@layout/widget_ghajar"
    android:resizeMode="horizontal|vertical"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
