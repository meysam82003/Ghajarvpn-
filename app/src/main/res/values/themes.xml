<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The window background is painted by the platform before Compose runs.
        It was the Material Light default, so every cold start flashed white
        before the near-black Premium Green canvas appeared. Pointing it at
        the brand canvas removes that flash. values-night/ carries the dark
        one; this file's value covers the light case.
    -->
    <style name="Theme.Ghajarvpn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ghajar_window_light</item>
    </style>

    <!--
        The widget's connect trampoline. It has no UI at all - it exists only
        because Android will not let a broadcast receiver start a foreground
        service - so it must not draw a window, dim what is behind it, or
        animate. Without this the home screen would visibly flash.
    -->
    <style name="Theme.Ghajarvpn.Invisible" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
