+			return "", 0, nil, newTemporaryNetError(
+				"DecodeSocks5UDPDatagram: truncated domain name")
+		}
+		host = string(datagram[position : position+length])
+		position += length
+
+	default:
+		return "", 0, nil, newTemporaryNetError(
+			"DecodeSocks5UDPDatagram: unsupported address type 0x%02x", atype)
+	}
