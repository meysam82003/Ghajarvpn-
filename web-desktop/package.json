{
  "name": "ghajar-app",
  "productName": "GhajarVPN",
  "version": "1.0.3",
  "description": "Ghajar VPN shop and account, as a desktop app",
  "author": "Ghajar VPN",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "ios-profile": "node ios/make-profile.mjs",
    "fetch-core": "node scripts/fetch-core.mjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ghajarvpn.desktop",
    "productName": "GhajarVPN",
    "artifactName": "GhajarVPN-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "offline.html",
      "icons/**"
    ],
    "icon": "build/icon.png",
    "afterPack": "./build/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ghajar VPN",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "title": "Ghajar VPN"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "syncDesktopName": true
    },
    "publish": null,
    "extraResources": [
      {
        "from": "core/${os}-${arch}",
        "to": "core",
        "filter": [
          "xray",
          "xray.exe",
          "geoip.dat",
          "geosite.dat",
          "LICENSE"
        ]
      }
    ]
  },
  "desktopName": "ghajarvpn.desktop"
}
