diff --git a/re/rx/function/database_helpers_2.php b/re/rx/function/database_helpers_2.php
index 6ecc109..93eeb1b 100644
--- a/re/rx/function/database_helpers_2.php
+++ b/re/rx/function/database_helpers_2.php
@@ -316,6 +316,134 @@ if (!function_exists('balance_atomic_credit')) {
     }
 }
 
+if (!function_exists('payment_report_wallet_credit_once')) {
+    /**
+     * Credit a confirmed payment exactly once. The Payment_report row is
+     * locked in the same transaction as the balance update, so webhook,
+     * return-page and cron retries cannot double-credit a user.
+     *
+     * @return array{ok:bool,credited:bool,balance:float,reason:string}
+     */
+    function payment_report_wallet_credit_once($orderId, $reason, $username = '', $amount = null) {
+        global $pdo;
+        if (!($pdo instanceof PDO)) {
+            return ['ok' => false, 'credited' => false, 'balance' => 0.0, 'reason' => 'pdo-unavailable'];
+        }
+
+        static $schemaReady = null;
+        if ($schemaReady === null) {
+            $schemaReady = false;
+            try {
+                // Direct gateway/webhook entry points can reach this helper on
+                // installations that have not rerun table.php yet. Ensure every
+                // column used by the atomic claim exists, not only its lock bit.
+                $columns = [
+                    'fulfillment_status' => "VARCHAR(24) NOT NULL DEFAULT 'pending'",
+                    'fulfillment_error' => 'TEXT NULL',
+                    'fulfilled_at' => 'VARCHAR(20) NULL',
+                    'wallet_fallback_applied' => 'TINYINT(1) NOT NULL DEFAULT 0',
+                ];
+                foreach ($columns as $name => $ddl) {
+                    $check = $pdo->query("SHOW COLUMNS FROM Payment_report LIKE " . $pdo->quote($name));
+                    if (!$check || $check->fetch(PDO::FETCH_ASSOC) === false) {
+                        $pdo->exec("ALTER TABLE Payment_report ADD COLUMN `{$name}` {$ddl}");
+                    }
+                }
+                $schemaReady = true;
+            } catch (Throwable $e) {
+                error_log('[wallet-credit-once] schema unavailable: ' . $e->getMessage());
+            }
+        }
+        if (!$schemaReady) {
+            return ['ok' => false, 'credited' => false, 'balance' => 0.0, 'reason' => 'schema-unavailable'];
+        }
+
+        $ownsTransaction = !$pdo->inTransaction();
+        try {
+            if ($ownsTransaction) $pdo->beginTransaction();
+            $lock = $pdo->prepare('SELECT * FROM Payment_report WHERE id_order = :o LIMIT 1 FOR UPDATE');
+            $lock->execute([':o' => (string)$orderId]);
+            $report = $lock->fetch(PDO::FETCH_ASSOC);
+            if (!is_array($report)) throw new RuntimeException('payment-report-missing');
+
+            $userId = (string)($report['id_user'] ?? '');
+            $note = (string)($report['dec_not_confirmed'] ?? '');
+            $already = (int)($report['wallet_fallback_applied'] ?? 0) === 1
+                || stripos($note, 'wallet_credited_only:') !== false
+                || stripos($note, 'auto-refund') !== false;
+            if ($already) {
+                $balanceStmt = $pdo->prepare('SELECT Balance FROM user WHERE id = :u LIMIT 1');
+                $balanceStmt->execute([':u' => $userId]);
+                $balance = (float)$balanceStmt->fetchColumn();
+                if ($ownsTransaction) $pdo->commit();
+                return ['ok' => true, 'credited' => false, 'balance' => $balance, 'reason' => 'already-credited'];
+            }
+            if (stripos($note, 'service-created') !== false) {
+                if ($ownsTransaction) $pdo->commit();
+                return ['ok' => true, 'credited' => false, 'balance' => 0.0, 'reason' => 'service-created'];
+            }
+
+            $invoiceField = trim((string)($report['id_invoice'] ?? ''));
+            if (strpos($invoiceField, 'getconfigafterpay|') === 0) {
+                $target = trim(substr($invoiceField, strlen('getconfigafterpay|')));
+                if ($target !== '') {
+                    $invoiceStmt = $pdo->prepare(
+                        "SELECT Status FROM invoice WHERE id_user = :u AND username = :n ORDER BY id_invoice DESC LIMIT 1"
+                    );
+                    $invoiceStmt->execute([':u' => $userId, ':n' => $target]);
+                    $invoiceStatus = strtolower(trim((string)$invoiceStmt->fetchColumn()));
+                    if (in_array($invoiceStatus, ['active', 'end_of_time', 'end_of_volume', 'sendedwarn', 'send_on_hold'], true)) {
+                        if ($ownsTransaction) $pdo->commit();
+                        return ['ok' => true, 'credited' => false, 'balance' => 0.0, 'reason' => 'service-created'];
+                    }
+                    if ((string)$username === '') $username = $target;
+                }
+            }
+
+            $credit = $amount === null
+                ? (float)($report['price'] ?? 0) + (float)($report['charge_bonus'] ?? 0)
+                : (float)$amount;
+            if ($userId === '' || $credit <= 0) throw new RuntimeException('invalid-credit-target');
+
+            $safeUsername = preg_replace('/[^A-Za-z0-9_.-]/', '_', trim((string)$username));
+            $safeReason = preg_replace('/[^A-Za-z0-9_.-]/', '-', trim((string)$reason));
+            $marker = 'wallet_credited_only:' . $safeUsername . '|credit-once:' . $safeReason;
+            $claim = $pdo->prepare(
+                "UPDATE Payment_report
+                    SET wallet_fallback_applied = 1,
+                        fulfillment_status = 'wallet_credited',
+                        fulfillment_error = NULL,
+                        fulfilled_at = :at,
+                        dec_not_confirmed = CASE
+                            WHEN dec_not_confirmed IS NULL OR dec_not_confirmed = '' THEN :marker1
+                            ELSE CONCAT(dec_not_confirmed, ' | ', :marker2)
+                        END
+                  WHERE id_order = :o AND COALESCE(wallet_fallback_applied, 0) = 0"
+            );
+            $claim->execute([
+                ':at' => (string)time(),
+                ':marker1' => $marker,
+                ':marker2' => $marker,
+                ':o' => (string)$orderId,
+            ]);
+            if ($claim->rowCount() !== 1) throw new RuntimeException('credit-lock-lost');
+
+            $creditStmt = $pdo->prepare('UPDATE user SET Balance = Balance + :d WHERE id = :u');
+            $creditStmt->execute([':d' => $credit, ':u' => $userId]);
+            if ($creditStmt->rowCount() !== 1) throw new RuntimeException('wallet-user-missing');
+            $balanceStmt = $pdo->prepare('SELECT Balance FROM user WHERE id = :u LIMIT 1');
+            $balanceStmt->execute([':u' => $userId]);
+            $balance = (float)$balanceStmt->fetchColumn();
+            if ($ownsTransaction) $pdo->commit();
+            return ['ok' => true, 'credited' => true, 'balance' => $balance, 'reason' => 'credited'];
+        } catch (Throwable $e) {
+            if ($ownsTransaction && $pdo->inTransaction()) $pdo->rollBack();
+            error_log('[wallet-credit-once] order=' . (string)$orderId . ' failed: ' . $e->getMessage());
+            return ['ok' => false, 'credited' => false, 'balance' => 0.0, 'reason' => $e->getMessage()];
+        }
+    }
+}
