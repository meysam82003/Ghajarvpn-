@@ -181,3 +191,55 @@ func (t *packetConnTracker) ReaderReplaceable() bool {
 func (t *packetConnTracker) WriterReplaceable() bool {
 	return true
 }
+
+// Deliberately do not expose Upstream/ReaderReplaceable: optimized copy must
+// still pass the freeze barrier, even when it unwraps the inner counter conn.
+type ghajarConn struct {
+	net.Conn
+	manager *Manager
+}
+
+func (c *ghajarConn) Read(p []byte) (int, error) {
+	if !c.manager.ghajarBeginIO() {
+		return 0, net.ErrClosed
+	}
+	defer c.manager.ghajarIO.Done()
+	return c.Conn.Read(p)
+}
+func (c *ghajarConn) Write(p []byte) (int, error) {
+	if !c.manager.ghajarBeginIO() {
+		return 0, net.ErrClosed
+	}
+	defer c.manager.ghajarIO.Done()
+	return c.Conn.Write(p)
+}
+
+type ghajarPacketConn struct {
+	N.PacketConn
+	manager *Manager
+}
+
+// Keep packet buffer requirements visible without exposing Upstream: the copy
+// optimizer must never unwrap the freeze barrier. SOCKS UDP adds a header on
+// replies and panics if the caller allocates a buffer without this headroom.
+func (c *ghajarPacketConn) FrontHeadroom() int  { return N.CalculateFrontHeadroom(c.PacketConn) }
+func (c *ghajarPacketConn) RearHeadroom() int   { return N.CalculateRearHeadroom(c.PacketConn) }
+func (c *ghajarPacketConn) ReaderOverhead() int { return N.CalculateReaderOverhead(c.PacketConn) }
+func (c *ghajarPacketConn) ReaderMTU() int      { return N.CalculateMTU(c.PacketConn, nil) }
+func (c *ghajarPacketConn) WriterMTU() int      { return N.CalculateMTU(nil, c.PacketConn) }
+
+func (c *ghajarPacketConn) ReadPacket(b *buf.Buffer) (M.Socksaddr, error) {
+	if !c.manager.ghajarBeginIO() {
+		return M.Socksaddr{}, net.ErrClosed
+	}
+	defer c.manager.ghajarIO.Done()
+	return c.PacketConn.ReadPacket(b)
+}
+func (c *ghajarPacketConn) WritePacket(b *buf.Buffer, d M.Socksaddr) error {
+	if !c.manager.ghajarBeginIO() {
+		b.Release()
+		return net.ErrClosed
+	}
+	defer c.manager.ghajarIO.Done()
+	return c.PacketConn.WritePacket(b, d)
+}
