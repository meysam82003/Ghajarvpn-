@@ -132,10 +136,16 @@ func (t *flowTracker) AttachFlow(handle tun.FlowHandle) {
 
 func (t *flowTracker) CountForward(n int) {
 	t.metadata.Upload.Add(int64(n))
+	if t.metadata.Metadata.Inbound != "ghajar-vault-probe" {
