@@ -2,6 +2,7 @@ package trafficcontrol
 
 import (
 	"sync"
+	"sync/atomic"
 	"time"
 
 	"github.com/sagernet/sing-box/adapter"
@@ -35,6 +36,11 @@ var (
 )
 
 type Manager struct {
+	ghajarGate              sync.Mutex
+	ghajarFrozen            bool
+	ghajarIO                sync.WaitGroup
+	ghajarUpload            atomic.Int64
+	ghajarDownload          atomic.Int64
 	connections             compatible.Map[uuid.UUID, Tracker]
 	closedConnectionsAccess sync.Mutex
 	closedConnections       list.List[TrackerMetadata]
@@ -187,3 +193,35 @@ func (m *Manager) Clear() {
 	}
 	m.closedConnections.Init()
 }
+
+// GhajarUsage counts payload crossing routed TCP/UDP connections, including closed
+// connections. Counters do not depend on the UI connection history or its eviction.
+func (m *Manager) GhajarUsage() (int64, int64) {
+	return m.ghajarUpload.Load(), m.ghajarDownload.Load()
+}
+func (m *Manager) ghajarCounters(inbound string, up, down *atomic.Int64) ([]*atomic.Int64, []*atomic.Int64) {
+	if inbound == "ghajar-vault-probe" {
+		return []*atomic.Int64{up}, []*atomic.Int64{down}
+	}
+	return []*atomic.Int64{up, &m.ghajarUpload}, []*atomic.Int64{down, &m.ghajarDownload}
+}
+
+// Freeze denies new I/O, closes all routed sockets and waits for in-flight counter
+// updates. The returned totals are final and cannot race a reconnect/stop snapshot.
+func (m *Manager) GhajarFreeze() (int64, int64) {
+	m.ghajarGate.Lock()
+	m.ghajarFrozen = true
+	m.ghajarGate.Unlock()
+	m.connections.Range(func(_ uuid.UUID, tracker Tracker) bool { tracker.Close(); return true })
+	m.ghajarIO.Wait()
+	return m.GhajarUsage()
+}
+func (m *Manager) ghajarBeginIO() bool {
+	m.ghajarGate.Lock()
+	defer m.ghajarGate.Unlock()
+	if m.ghajarFrozen {
+		return false
+	}
+	m.ghajarIO.Add(1)
+	return true
+}
